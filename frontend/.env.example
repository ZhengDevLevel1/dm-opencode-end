# API 基础地址。默认使用 Vite 代理，保持 /api 即可。
# 直连后端可设置为 http://localhost:8080/api
VITE_API_BASE_URL=/api

# 可选：商品图片静态资源地址，例如 https://static.example.com
# 后端返回 /images/... 形式的相对路径，且后端未提供静态资源。
# 不配置时相对路径会显示为渐变占位图；配置后会把相对路径拼接到该地址。
VITE_IMAGE_BASE_URL=

# 高德地图 Web 端 JS API Key（不是 Web 服务/REST Key）。
# 请复制本文件为 .env 后填写；.env 已被 Git 忽略，不要提交真实 Key。
VITE_AMAP_KEY=

# 高德 JS API 安全密钥（securityJsCode），必须与上方 Key 配套填写。
VITE_AMAP_SECURITY_CODE=
