# AI service / main backend shared configuration.
# Copy to a local ignored file or export these variables in your shell.
# Never commit real API keys.

NACOS_ADDR=127.0.0.1:8848
NACOS_ENABLED=true
AI_SERVICE_NAME=flower-ai-service
AI_SERVICE_PORT=8081
AI_INTERNAL_TOKEN=flower-ai-internal-dev-token
AI_BASE_URL=http://127.0.0.1:8081

QDRANT_URL=http://127.0.0.1:6333
QDRANT_PRODUCT_COLLECTION=flower_products
QDRANT_KNOWLEDGE_COLLECTION=flower_knowledge

SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Read-only MySQL account used by ai-service.
AI_DB_URL=jdbc:mysql://localhost:3306/flower_shop?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
AI_DB_USERNAME=flower_ai_ro
AI_DB_PASSWORD=

# Main backend AI switches and budget.
APP_AI_ENABLED=true
APP_AI_CHAT_ENABLED=true
APP_AI_MERCHANT_ENABLED=true
APP_AI_CHAT_ALLOW_ANONYMOUS=true
APP_AI_DAILY_BUDGET=20.00
APP_AI_RECOMMENDATION_MODE=TF_IDF
